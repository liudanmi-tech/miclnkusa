# 复制为 .env 后填写，两个 key 填一个即可（都填时优先用 OpenRouter）。都不填时自动进入模拟模式。
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# 可选：换模型（OpenRouter 用 google/ 前缀的模型名）
# DREAM_TEXT_MODEL=google/gemini-2.5-flash
# DREAM_IMAGE_MODEL=google/gemini-2.5-flash-image

# 可选：有 key 也强制用模拟数据
# DREAM_MOCK=1

# 在国内网络下运行时需要代理（google-genai 和 httpx 都会读取这两个变量）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
