# 复制为 .env 后填写。不填 GEMINI_API_KEY 时自动进入模拟模式。
GEMINI_API_KEY=

# 可选：换模型
# DREAM_TEXT_MODEL=gemini-2.5-flash
# DREAM_IMAGE_MODEL=gemini-3.1-flash-image-preview

# 可选：有 key 也强制用模拟数据
# DREAM_MOCK=1

# 在国内网络下运行时需要代理（google-genai 会读取这两个变量）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
